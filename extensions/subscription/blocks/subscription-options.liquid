<link rel="stylesheet" href="{{ 'subscription.css' | asset_url }}">

{%- if product.selling_plan_groups.size > 0 -%}

{%- comment -%} Pass accent color from block settings into CSS variable {%- endcomment -%}
<style>
  #sub-widget-{{ block.id }} {
    --sub-accent: {{ block.settings.accent_color }};
    --sub-accent-light: {{ block.settings.accent_color }}18;
    --sub-border-active: {{ block.settings.accent_color }};
    --sub-bg-active: {{ block.settings.accent_color }}0f;
    --sub-shadow-active: 0 0 0 3px {{ block.settings.accent_color }}26;
  }

  {%- comment -%}
    Merchant CSS from the block's "Custom CSS" setting. Emitted last so it
    overrides subscription.css at equal specificity, since this tag already
    follows that stylesheet's link.

    Written raw rather than wrapped in a selector: merchants write complete
    rules, and wrapping would only allow bare property declarations.

    The replace filters are forgiveness, not security. Pasting a whole style
    element is common, and its closing tag would otherwise terminate this one
    early and spill the remainder onto the page as visible text. The needles are
    assembled with append because a literal closing style tag cannot appear
    inside a style element without ending it.

    strip_html is deliberately avoided: it strips everything between angle
    brackets and so would mangle valid CSS media queries that use a less-than
    comparison.
  {%- endcomment -%}
  {%- if block.settings.custom_css != blank -%}
  {%- assign style_close = '</' | append: 'style>' -%}
  {%- assign style_open  = '<'  | append: 'style>' -%}
  {{ block.settings.custom_css | replace: style_close, '' | replace: style_open, '' }}
  {%- endif -%}
</style>

{%- comment -%}
  data-design is rendered here rather than fetched, so the layout is correct on
  first paint. The app admin (Settings → Widget designs) can still override it,
  but that override goes through the app proxy and is therefore best-effort;
  this is the value that always works.
{%- endcomment -%}
<div class="sub-widget" id="sub-widget-{{ block.id }}" data-design="{{ block.settings.design }}">

  {%- comment -%}
    Per-variant map of the selling plans actually allocated to each variant:
    { "<variantId>": { "<sellingPlanId>": <subscriptionPriceInCents>, ... }, ... }
    The JS uses this to only show a subscription for the variants it was assigned to.
  {%- endcomment -%}
  <script type="application/json" class="sub-variant-plans">
  {
    {%- for variant in product.variants -%}
      "{{ variant.id }}": {
        {%- for alloc in variant.selling_plan_allocations -%}
          "{{ alloc.selling_plan.id }}": {{ alloc.price | default: variant.price }}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  }
  </script>

  <p class="sub-widget__label">Purchase Options</p>

  <div class="sub-widget__options" role="radiogroup" aria-label="Purchase options">

    {%- comment -%} ONE-TIME PURCHASE {%- endcomment -%}
    <label class="sub-option sub-option--active" for="sub-onetime-{{ block.id }}">
      <input
        class="sub-option__radio"
        type="radio"
        id="sub-onetime-{{ block.id }}"
        name="sub_purchase_option_{{ block.id }}"
        value=""
        autocomplete="off"
        checked
      />
      <span class="sub-option__inner">
        <span class="sub-option__left">
          <span class="sub-option__dot"></span>
          <span class="sub-option__title">One-time purchase</span>
        </span>
        <span class="sub-option__price" data-base-price="{{ product.selected_or_first_available_variant.price }}">
          {{ product.selected_or_first_available_variant.price | money }}
        </span>
      </span>
    </label>

    {%- comment -%} SUBSCRIPTION OPTIONS {%- endcomment -%}
    {%- for group in product.selling_plan_groups -%}
      {%- for plan in group.selling_plans -%}

        {%- assign base_price   = product.selected_or_first_available_variant.price -%}
        {%- assign discount_pct = 0 -%}
        {%- assign final_price  = base_price -%}

        {%- for adj in plan.price_adjustments -%}
          {%- if adj.value_type == 'percentage' -%}
            {%- assign discount_pct = adj.value -%}
            {%- assign discount_amt = base_price | times: discount_pct | divided_by: 100 -%}
            {%- assign final_price  = base_price | minus: discount_amt -%}
          {%- elsif adj.value_type == 'fixed_amount' -%}
            {%- assign final_price  = base_price | minus: adj.value -%}
          {%- elsif adj.value_type == 'price' -%}
            {%- assign final_price  = adj.value -%}
          {%- endif -%}
        {%- endfor -%}

        <label
          class="sub-option"
          for="sub-plan-{{ plan.id }}-{{ block.id }}"
          data-plan-id="{{ plan.id }}"
          data-plan-price="{{ final_price }}"
          data-discount="{{ discount_pct }}"
        >
          <input
            class="sub-option__radio"
            type="radio"
            id="sub-plan-{{ plan.id }}-{{ block.id }}"
            name="sub_purchase_option_{{ block.id }}"
            value="{{ plan.id }}"
            autocomplete="off"
          />
          <span class="sub-option__inner">
            <span class="sub-option__left">
              <span class="sub-option__dot"></span>
              <span class="sub-option__title">
                {{ group.name }}
                {%- if discount_pct > 0 -%}
                  <span class="sub-option__badge">SAVE {{ discount_pct }}%</span>
                {%- endif -%}
              </span>
            </span>
            <span class="sub-option__price">
              {{ final_price | money }}
            </span>
          </span>
        </label>

      {%- endfor -%}
    {%- endfor -%}

  </div>

  {%- if block.settings.show_savings -%}
    <div class="sub-widget__savings" id="sub-savings-{{ block.id }}" aria-live="polite"></div>
  {%- endif -%}

</div>

{%- endif -%}

<script src="{{ 'subscription.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Subscription Options",
  "target": "section",
  "templates": ["product"],
  "settings": [
    {
      "type": "select",
      "id": "design",
      "label": "Design",
      "info": "Overridden by Settings → Widget designs in the Smart Subscriptions app when that app is reachable.",
      "options": [
        { "value": "default",  "label": "Default — standard option list" },
        { "value": "arctic",   "label": "Arctic — save badge inline, frequency picker" },
        { "value": "ribbon",   "label": "Ribbon — save badge on a corner ribbon" }
      ],
      "default": "arctic"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#f97316"
    },
    {
      "type": "checkbox",
      "id": "show_savings",
      "label": "Show savings callout",
      "default": true
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS",
      "info": "Write full CSS rules. Useful selectors: .sub-widget, .sub-option, .sub-option--active, .sub-option__title, .sub-option__price, .sub-option__badge, .sub-widget__savings"
    }
  ]
}
{% endschema %}

