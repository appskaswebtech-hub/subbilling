generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Shopify Default Session (keep as-is) ───────────────────────────────────
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?   @db.Text
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model SellingPlanGroup {
  id              String   @id @default(cuid())
  shop            String
  // Full GID. NOT usable to match the storefront: Liquid exposes a selling plan
  // GROUP's id only as a hash ("e88ff8fd…"), never as this numeric id.
  shopifyGroupId  String?
  // The group's single selling plan, as a full GID. Liquid DOES expose a selling
  // PLAN's id as a number (it is the cart's `selling_plan` value), so this is the
  // only key that can join a stored plan to what the storefront renders.
  shopifySellingPlanId String?
  name            String
  interval        String
  intervalCount   Int
  discount        Float    @default(0)
  discountType    String   @default("percentage")

  // ── Storefront widget ───────────────────────────────────────
  // Per-plan overrides of the shop-wide AppSettings values. Empty means
  // "inherit the shop setting". A product may have several plans attached; the
  // widget renders whichever one the shopper currently has selected.
  widgetDesign       String @default("")
  // Newline-separated, same format as AppSettings.widgetBenefitChips.
  widgetBenefitChips String @default("") @db.VarChar(1000)
  // Same "" = inherit convention as widgetDesign. Named to mirror the
  // AppSettings columns, but note the defaults differ on purpose: AppSettings
  // holds real values ("#5B4FCB"), a plan holds "inherit".
  widgetPrimaryColor String @default("")
  widgetBadgeColor   String @default("")
  // Nullable rather than "" = inherit: 0 is a legitimate radius, so a numeric
  // column has no spare value to mean "unset".
  widgetBorderRadius Int?

  // ── Payment ─────────────────────────────────────────────────
  // "POSTPAID": the cron charges the customer's saved card each cycle.
  // "PREPAID":  before each cycle the customer is emailed a link to confirm and
  //             pay, and the cycle ships only once they do (app/lib/prepaid.server.ts).
  // Copied onto each Subscription when it is created, so changing it affects new
  // subscribers only.
  paymentMode        String @default("POSTPAID")
  // Who sends a prepaid plan's payment email: "SHOPIFY" (draft order invoice) or
  // "SMTP" (the merchant's own server, configured in AppSettings). Read at send
  // time, so a change applies to the next email.
  paymentEmailSender String @default("SHOPIFY")

  // ── Leftover: unused ────────────────────────────────────────
  // Added for a custom per-cycle billing schedule whose code was later reverted.
  // The column is still in the database, so it is declared here to keep schema
  // and database in step. NOTHING reads it — do not go looking for the feature.
  customSchedule  String   @default("") @db.VarChar(1000)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([shop])
}

model Subscription {
  id                String   @id @default(cuid())
  shop              String
  shopifyContractId String   @unique                // ← was String? — must be unique for upsert
  customerId        String
  customerEmail     String
  productTitle      String
  planName          String
  status            String   @default("ACTIVE")
  price             Float
  frequency         String
  nextBillingDate   DateTime

  // Selling plan GID of the contract's first line, set when the row is created.
  // It is how a subscription finds its plan (or bundle) again, e.g. for the
  // prepaid email sender.
  sellingPlanId     String?

  // "POSTPAID" | "PREPAID", copied from the plan or bundle at creation — see
  // SellingPlanGroup.paymentMode. The billing cron charges POSTPAID rows; PREPAID
  // rows are invoiced by email instead.
  paymentMode       String   @default("POSTPAID")
  // ProductBundle.id when the contract came from a recurring bundle.
  bundleId          String?

  // ── Leftover: unused ──────────────────────────────────────
  // Same reverted billing-schedule feature as SellingPlanGroup.customSchedule.
  // Declared only so schema and database agree; nothing reads it.
  scheduleIndex     Int      @default(0)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  billingAttempts   BillingAttempt[]
  prepaidInvoices   PrepaidInvoice[]

  @@index([shop])
  @@index([status])
  @@index([shop, customerId])
}

model BillingAttempt {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  amount         Float
  status         String
  errorMessage   String?
  createdAt      DateTime     @default(now())

  @@index([subscriptionId])
}

model AppSettings {
  id                    String   @id @default(cuid())
  shop                  String   @unique          // one settings row per shop

  // ── Notifications ──────────────────────────────────────────
  notifyOnBillingFailure  Boolean  @default(true)
  notifyOnCancellation    Boolean  @default(true)
  notifyOnNewSubscription Boolean  @default(false)
  notificationEmail       String   @default("")   // override email; empty = use shop owner email

  // ── Billing behaviour ──────────────────────────────────────
  maxBillingRetries     Int      @default(3)      // how many times to retry a failed charge
  gracePeriodDays       Int      @default(7)      // days before cancelling after repeated failures

  // ── Customer portal ────────────────────────────────────────
  allowCustomerPause    Boolean  @default(true)   // show Pause button in customer portal
  allowCustomerCancel   Boolean  @default(true)   // show Cancel button in customer portal


  // ── Widget appearance ───────────────────────────────────────
  widgetPrimaryColor    String   @default("#5B4FCB")
  widgetBadgeColor      String   @default("#F5A623")
  widgetBorderRadius    Int      @default(10)
  widgetShowOnetime     Boolean  @default(true)
  widgetDesign          String   @default("arctic")
  // Newline-separated chip labels for the "benefits" design.
  // "{discount}" is substituted with the plan's discount when rendered.
  // Wider than Prisma's default VarChar(191): six chips joined can exceed it.
  widgetBenefitChips    String   @default("") @db.VarChar(1000)

  // ── Prepaid payments ────────────────────────────────────────
  // How long a payment link stays open. A reminder goes out halfway through; an
  // unpaid renewal is paused when it ends.
  prepaidPayWindowDays   Int     @default(7)
  // How many days before the billing date the payment link is sent, so the
  // customer can pay before the cycle is due.
  prepaidInvoiceLeadDays Int     @default(3)

  // Merchant's own wording for the payment emails. Empty (or null) = the
  // built-in text in app/config/payment.ts (PREPAID_EMAIL_DEFAULTS). Supports
  // the placeholders listed there, e.g. {subscription} and {due_date}.
  prepaidInitialSubject  String  @default("")
  prepaidRenewalSubject  String  @default("")
  prepaidReminderSubject String  @default("")
  // Nullable rather than @default(""): MySQL cannot give a TEXT column a default.
  prepaidInitialMessage  String? @db.Text
  prepaidRenewalMessage  String? @db.Text
  prepaidReminderMessage String? @db.Text

  // ── Merchant SMTP ───────────────────────────────────────────
  // Used by prepaid plans whose paymentEmailSender is "SMTP". The password is
  // stored ONLY as AES-GCM ciphertext (app/lib/secret-box.server.ts) and is never
  // sent back to the browser.
  smtpHost              String   @default("")
  smtpPort              Int      @default(587)
  smtpSecure            Boolean  @default(false)   // true = implicit TLS (usually port 465)
  smtpUser              String   @default("")
  // Nullable rather than @default(""): MySQL cannot give a TEXT column a default.
  smtpPassEnc           String?  @db.Text
  smtpFrom              String   @default("")

  // Automatic app discount that prices one-time bundles (extensions/bundle-discount).
  // Created with the shop's first one-time bundle.
  bundleDiscountId      String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([shop])
}
model ShopPlan {
  id               Int       @id @default(autoincrement())
  shop             String    @unique
  plan             String    @default("free")   // "free" | "basic" | "pro" | "advanced"
  subscriptionId   String?                       // Shopify AppSubscription GID
  // AppSubscriptionLineItem GID of the usage-priced line. Required by
  // appUsageRecordCreate — the AppSubscription GID in `subscriptionId` is NOT
  // accepted there. Null on flat-fee plans, which have no usage line item.
  usageLineItemId  String?
  // Currency the AppSubscription was created in, from shopBillingPreferences
  // at approval time. Usage records MUST be priced in it. Stored rather than
  // re-queried because Shopify fixes it at approval: a merchant who later
  // changes their billing currency keeps the old one on this subscription.
  billingCurrency  String    @default("USD")
  status           String    @default("active")  // "active" | "cancelled" | "expired"
  trialEndsAt      DateTime?
  billingStartedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([shop])
}

// ─── Commission ledger ────────────────────────────────────────────────────────
// One row per successful subscription charge on a commission-priced plan.
// Doubles as the audit trail shown to the merchant and as the idempotency guard.
model CommissionCharge {
  id               String   @id @default(cuid())
  shop             String
  // The local BillingAttempt that earned this commission. UNIQUE — this is the
  // idempotency guard: Shopify retries webhooks, and the success handler is not
  // otherwise re-entrant.
  billingAttemptId String   @unique
  contractId       String                        // Shopify subscription contract GID
  baseAmount       Float                         // order total the rate was applied to
  rate             Float                         // rate at charge time, so historic rows survive a rate change
  amount           Float                         // commission actually charged
  currency         String   @default("USD")
  status           String   @default("CHARGED")  // "CHARGED" | "SKIPPED" | "FAILED"
  reason           String?                       // "capped" | "no-usage-line" | API error text
  usageRecordId    String?                       // Shopify AppUsageRecord GID
  createdAt        DateTime @default(now())

  @@index([shop])
  @@index([shop, createdAt])
}

// ─── Prepaid invoices ─────────────────────────────────────────────────────────
// One "confirm and pay" request: a Shopify draft order plus the email that
// carries its link. See app/lib/prepaid.server.ts.
//
//   INITIAL  a merchant set up a prepaid subscription for a customer. There is
//            no contract yet; `setupJson` holds what is needed to create one
//            once the customer pays.
//   RENEWAL  the next cycle of an existing prepaid subscription.
model PrepaidInvoice {
  id             String        @id @default(cuid())
  shop           String
  kind           String                               // "INITIAL" | "RENEWAL"
  // Null for an INITIAL invoice until its payment creates the contract.
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  // Null only between the row being claimed and the draft order being created.
  draftOrderId   String?       @unique
  invoiceUrl     String?       @db.Text
  orderId        String?                              // Order GID once paid
  amount         Float         @default(0)
  currency       String        @default("USD")
  // The billing date this invoice pays for. With subscriptionId it is the
  // idempotency key: a cycle can be invoiced only once.
  cycleDate      DateTime
  sender         String        @default("SHOPIFY")    // "SHOPIFY" | "SMTP" — what was actually used
  // "CREATING" | "SENT" | "PAID" | "EXPIRED" | "CANCELLED" | "FAILED"
  status         String        @default("CREATING")
  sentAt         DateTime?
  reminderSentAt DateTime?
  dueAt          DateTime?
  paidAt         DateTime?
  error          String?       @db.Text
  setupJson      String?       @db.Text

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([subscriptionId, cycleDate])
  @@index([shop, status])
  @@index([status])
}

// ─── Product bundles ──────────────────────────────────────────────────────────
// A fixed set of products the merchant sells together at a discount, offered on
// the page of every product in it.
//
//   RECURRING  every line goes in the cart with the bundle's OWN selling plan,
//              so they all land on one contract and renew together. That plan
//              lives in a hidden selling plan group (appId "kas-bundle") whose
//              pricing policy IS the bundle discount, so renewals keep it.
//   ONE_TIME   plain lines without a selling plan, discounted at checkout by the
//              bundle-discount function: every item the shopper kept ticked.
//
// Named ProductBundle rather than Bundle: an earlier, removed feature left
// `Bundle`/`BundleItem` tables behind in some databases.
model ProductBundle {
  id                 String   @id @default(cuid())
  shop               String
  name               String
  // Product GID of the bundle's lead product (its first item), used for its
  // name and image in lists. The storefront shows the bundle on every item's page.
  mainProductId      String
  type               String   @default("RECURRING")   // "RECURRING" | "ONE_TIME"
  discountPercent    Float    @default(0)
  active             Boolean  @default(true)
  position           Int      @default(0)
  // Storefront theme: "classic" | "together" | "compact" | "savings"
  // (extensions/subscription/assets/bundle-offer.js, app/components/BundlePreview.tsx).
  design             String   @default("classic")
  // Which product pages show the bundle:
  //   "ITEMS"  the page of every product in it (the original behaviour)
  //   "BASE"   only the pages of its base products (baseProducts below)
  showOn             String   @default("ITEMS")

  // ── Kind and pricing (app/config/bundle-pricing.ts) ─────────
  //   kind "SET"  a fixed set; shoppers can untick items.
  //        "BOX"  build-your-own: the shopper picks at least minItems units
  //               from the items (the pool), repeats allowed.
  kind               String   @default("SET")
  //   "PERCENT"      discountPercent off every ticked item
  //   "FIXED_PRICE"  fixedPrice for the full set (sets only). discountPercent
  //                  then holds the matching percentage, recomputed on save
  //                  from current prices: what recurring bundles and partial
  //                  sets use, since a selling plan can't hold a total.
  //   "TIERED"       the percentage grows with ticked units (tiersJson)
  pricingMode        String   @default("PERCENT")
  fixedPrice         Float?
  minItems           Int      @default(0)
  // [{ minItems, percent, sellingPlanId? }] ascending. sellingPlanId is the
  // tier's own selling plan on recurring bundles, set by the plan sync.
  tiersJson          String?  @db.Text

  // ── RECURRING only ─────────────────────────────────────────
  interval           String   @default("MONTH")       // DAY | WEEK | MONTH | YEAR
  intervalCount      Int      @default(1)
  paymentMode        String   @default("POSTPAID")    // see SellingPlanGroup.paymentMode
  paymentEmailSender String   @default("SHOPIFY")
  shopifyGroupId       String?
  shopifySellingPlanId String?

  items              ProductBundleItem[]
  baseProducts       ProductBundleBase[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([shop])
  @@index([shop, mainProductId])
}

model ProductBundleItem {
  id        String        @id @default(cuid())
  bundleId  String
  bundle    ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId String        // product GID — what the bundle's selling plan group attaches to
  variantId String        // variant GID — what goes in the cart
  // Kept so the storefront can fetch live price and image from
  // /products/<handle>.js instead of trusting a stored price that goes stale.
  handle    String
  title     String
  quantity  Int           @default(1)
  // true: the shopper picks size/colour on the storefront and any variant of
  // the product counts; variantId is only the default (and what a merchant-
  // created prepaid subscription uses). false: exactly this variant.
  variantChoice Boolean   @default(false)

  @@index([bundleId])
  // The storefront lookup: a bundle is offered on the page of every product in it.
  @@index([productId])
}

// A product whose page shows the bundle when its showOn is "BASE". It doesn't
// have to be in the bundle and is never added to the cart with it: a "wax +
// leash" bundle can be offered on every snowboard's page.
model ProductBundleBase {
  id        String        @id @default(cuid())
  bundleId  String
  bundle    ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId String        // product GID
  handle    String
  title     String

  @@index([bundleId])
  // The storefront lookup for "BASE" bundles.
  @@index([productId])
}

// ─── Public API Key ───────────────────────────────────────────────────────────
// One API key per shop — used by merchants to access the public REST API
model ApiKey {
  id        String   @id @default(cuid())
  shop      String   @unique
  key       String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([shop])
}
model LoyaltyDiscount {
  id             String   @id @default(cuid())
  shop           String   @unique
  name           String   @default("Loyalty discount")
  applyOnRenewal Int      @default(1)
  discountValue  Float    @default(10)
  enabled        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
